# Required for Docker Compose. Use a unique URL-safe password; it is used in
# Compose's internal PostgreSQL connection URL.
POSTGRES_DB=gameintel
POSTGRES_USER=gameintel
POSTGRES_PASSWORD=

# Required for Bun commands run on the host. Use the same database credentials
# as above and localhost as the host, for example:
# postgres://gameintel:YOUR_URL_SAFE_PASSWORD@localhost:5432/gameintel
DATABASE_URL=

# Local web and API settings
PUBLIC_BASE_URL=http://localhost:4321
WEB_ORIGIN=http://localhost:4321
API_PORT=3000
LOCAL_OPERATOR_TOKEN=
GAMEINTEL_PROFILE=gta-vi

# Optional local OpenCode integration
OPENCODE_URL=http://host.docker.internal:4096
OPENCODE_USERNAME=
OPENCODE_PASSWORD=
OPENCODE_MODEL=openai/gpt-5.6-luna
OPENCODE_AGENT=research-writer
OPENCODE_ENABLED=false

# Optional host-only integrations
SUPADATA_API_KEY=
SOURCE_POLICY_ENFORCEMENT=strict

# GTA VI official media publishing. These are host-only and are never passed
# to the Compose API or migration containers. Never commit real credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional override for the ignored sync catalog path
GTA_VI_MEDIA_CATALOG_PATH=tmp/gta-vi-media/catalog.json
# Override only when the Cloudflare Worker uses a different immutable catalog key.
R2_MEDIA_CATALOG_KEY=
