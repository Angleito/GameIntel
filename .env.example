# Required for Docker Compose. Use a unique URL-safe password; it is used in
# Compose's internal PostgreSQL connection URL.
POSTGRES_DB=gameintel
POSTGRES_USER=gameintel
POSTGRES_PASSWORD=

# The application uses separate, least-privilege PostgreSQL logins. Each login
# is a member of exactly one capability group and none may equal POSTGRES_USER.
# Keep all database passwords URL-safe because Compose builds connection URLs.
#
# APP_DATABASE_USER (gameintel_runtime): the ingestion worker, scheduler,
# publisher, and operator CLI. Broad data role; never used by a public process.
APP_DATABASE_USER=gameintel_app
APP_DATABASE_PASSWORD=

# APP_OPERATOR_DATABASE_USER (gameintel_operator): the token-protected operator
# API surface only (jobs, submission moderation/promotion). Cannot approve
# evidence, approve media, or publish content.
APP_OPERATOR_DATABASE_USER=gameintel_operator_app
APP_OPERATOR_DATABASE_PASSWORD=

# APP_PUBLIC_DATABASE_USER (gameintel_public): the public API surface only
# (safe reads and quarantined community submissions). No UPDATE privileges.
APP_PUBLIC_DATABASE_USER=gameintel_public_app
APP_PUBLIC_DATABASE_PASSWORD=

# Required for host-side application commands. Use the runtime credentials and
# localhost as the host, for example:
# postgres://gameintel_app:YOUR_URL_SAFE_PASSWORD@localhost:5432/gameintel
DATABASE_URL=

# Required only for host-side schema migration commands. This uses the separate
# DDL-capable migration credentials, for example:
# postgres://gameintel:YOUR_URL_SAFE_PASSWORD@localhost:5432/gameintel
MIGRATION_DATABASE_URL=

# Required for the API process, which runs two storage identities. The public
# runtime uses the gameintel_public login; the operator runtime uses the
# gameintel_operator login. They never share a connection.
# postgres://gameintel_public_app:YOUR_URL_SAFE_PASSWORD@localhost:5432/gameintel
# postgres://gameintel_operator_app:YOUR_URL_SAFE_PASSWORD@localhost:5432/gameintel
PUBLIC_DATABASE_URL=
OPERATOR_DATABASE_URL=

# Local web and API settings
PUBLIC_BASE_URL=http://localhost:4321
WEB_ORIGIN=http://localhost:4321
API_PORT=3000
LOCAL_OPERATOR_TOKEN=
OPERATOR_ID=local-operator
GAMEINTEL_PROFILE=gta-vi

# Public community intake is disabled by default. Do not enable it until the
# deployment sits behind a proxy that strips and sets the configured IP header.
PUBLIC_SUBMISSIONS_ENABLED=false
SUBMISSION_TRUST_PROXY=false
SUBMISSION_TRUSTED_IP_HEADER=cf-connecting-ip
SUBMISSION_IDENTITY_SECRET=

# The Compose ingestion worker is the only process permitted to fetch registered
# source URLs. Its proxy endpoint is fixed in deployments/local/compose.yaml.
INGESTION_WORKER_ID=source-ingest-1
INGESTION_WORKER_POLL_MS=500

# The Compose scheduler continuously enqueues due registered sources.
# SCHEDULER_POLL_MS=10000

# Storage backend: postgres (reference deployment) or memory. The memory
# backend is single-process/test-only (bun test, CLI experiments); the API,
# worker, scheduler, and publisher require PostgreSQL and fail fast if memory
# is selected.
# GAMEINTEL_STORAGE=postgres

# Local object store root used by the runtime assembly (optional).
# GAMEINTEL_OBJECT_STORE_PATH=tmp/object-store

# Optional AI runtime for operator entry points (the CLI wires it for
# ingest/ingest-text/promote-submission). Provider selection: pi (default) or
# openrouter. AI is an assist — failures degrade to warnings and never block
# ingestion. The ingestion worker and the API never construct an AI runtime
# (isolation by construction). Keep provider credentials host-only.
AI_PROVIDER=pi
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OPENROUTER_MAX_OUTPUT_TOKENS=1500
OPENROUTER_MAX_RUNTIME_MS=120000
PI_MODEL=openai/gpt-5.6-terra
PI_ALLOWED_MODELS=openai/gpt-5.6-terra
PI_MAX_OUTPUT_TOKENS=1500
PI_MAX_RUNTIME_MS=120000
OPENAI_API_KEY=

# Required together when public submissions are enabled behind an ingress. The
# ingress must strip client-supplied IP headers and set these values itself.
SUBMISSION_TRUSTED_PROXY_TOKEN=

# Optional host-only integrations
SUPADATA_API_KEY=
SOURCE_POLICY_ENFORCEMENT=strict

# GTA VI official media publishing. These are host-only and are never passed
# to the Compose API or migration containers. Never commit real credentials.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_BUCKET=
R2_PUBLIC_BUCKET=
R2_PUBLIC_BASE_URL=
# Optional; defaults to https://$R2_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ENDPOINT=
# Optional override for the ignored sync catalog path (profile media scripts)
MEDIA_CATALOG_PATH=tmp/gta-vi-media/catalog.json
# Override only when the Cloudflare Worker uses a different immutable catalog key.
R2_MEDIA_CATALOG_KEY=
