{
  "name": "gameintelgg",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, evidence-aware source ingestion and publication platform for GameIntel",
  "workspaces": ["apps/*", "packages/*", "services/*", "adapters/*"],
  "scripts": {
    "dev": "bun run --filter @gameintel/web dev",
    "dev:api": "bun run --filter @gameintel/api dev",
    "build": "bun run --filter @gameintel/web build",
    "test": "bun test",
    "typecheck": "bun run --filter '*' typecheck",
    "db:migrate": "bun run scripts/migrate.ts",
    "db:purge": "bun run scripts/purge-retained-content.ts",
    "seed": "bun run scripts/seed.ts",
    "example": "bun run scripts/example.ts",
    "audit:generic": "bun run scripts/audit-generic-core.ts",
    "prepare:publication": "bun run scripts/prepare-publication.ts",
    "security:scan": "bun run scripts/audit-release.ts",
    "check:clean": "bun run scripts/check-repo-clean.ts",
    "release:check": "bun run security:scan && bun run audit:generic && bun install --frozen-lockfile && bun test && bun run typecheck && bun run check:clean && PUBLIC_BASE_URL=https://gameintel.example GAMEINTEL_RELEASE=true bun run build && GAMEINTEL_RELEASE=true bun run security:scan",
    "release:check:postgres": "GAMEINTEL_TEST_POSTGRES=true bun test adapters/postgres/src/adapter.test.ts adapters/postgres/src/privileges.test.ts",
    "operator": "bun run services/newsroom/src/cli.ts",
    "publish": "bun run services/publisher/src/index.ts",
    "export": "bun run services/publisher/src/index.ts",
    "media:sync": "bun run profiles/gta-vi/scripts/sync-media.ts",
    "media:publish": "bun run profiles/gta-vi/scripts/publish-media.ts"
  },
"dependencies": {
    "@gameintel/adapter-contract-tests": "workspace:*",
    "@gameintel/config": "workspace:*",
    "@gameintel/core": "workspace:*",
    "@gameintel/output": "workspace:*",
    "@gameintel/pipeline": "workspace:*",
    "@gameintel/postgres": "workspace:*",
    "@gameintel/r2": "workspace:*",
    "hono": "^4.7.2",
    "postgres": "^3.4.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "astro": "^7.2.9",
    "typescript": "^5.8.2"
  }
}
